// Система управления проектами — схема БД.
// Часы (оценка/план/факт) храним как Float — это не деньги, точность Decimal не нужна.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum EmployeeRole {
  OPERATOR // оператор
  MANAGER // руководитель
  DEVELOPER // разработчик
}

enum ProjectStatus {
  PLANNED // запланирован
  ACTIVE // в работе
  ON_HOLD // на паузе
  DONE // завершён
  CANCELLED // отменён
}

enum TaskStatus {
  TODO // в очереди
  IN_PROGRESS // в работе
  BLOCKED // заблокирована
  REVIEW // на ревью
  DONE // готово
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum AbsenceType {
  VACATION // отпуск
  SICK // больничный
  DAYOFF // отгул
  OTHER // прочее
}

model Employee {
  id             Int          @id @default(autoincrement())
  name           String
  email          String?      @unique
  role           EmployeeRole
  position       String? // должность/специализация свободным текстом
  weeklyHours    Float        @default(40) // плановая ёмкость в неделю
  active         Boolean      @default(true)
  telegramUserId String?      @unique // id пользователя Telegram (привязка через бота)
  createdAt      DateTime     @default(now())

  members     ProjectMember[]
  tasks       Task[] // задачи, где сотрудник — исполнитель
  timeLogs    TimeLog[]
  assignments Assignment[]
  absences    Absence[]
  trackings   TimeTracking[]
}

model Project {
  id          Int           @id @default(autoincrement())
  name        String
  code        String        @unique // короткий код, напр. CRM
  description String?
  status      ProjectStatus @default(PLANNED)
  color       String        @default("#3b82f6") // для календаря
  startDate   DateTime?
  dueDate     DateTime?
  botToken    String? // токен Telegram-бота проекта (бот подхватывает задачи/сотрудников)
  createdAt   DateTime      @default(now())

  members ProjectMember[]
  tasks   Task[]
}

// Назначение сотрудника на проект (многие-ко-многим, сотрудник может вести несколько проектов)
model ProjectMember {
  id            Int      @id @default(autoincrement())
  employeeId    Int
  projectId     Int
  roleOnProject String? // роль именно на этом проекте
  createdAt     DateTime @default(now())

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  project  Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([employeeId, projectId])
}

model Task {
  id            Int          @id @default(autoincrement())
  projectId     Int
  title         String
  description   String?
  status        TaskStatus   @default(TODO)
  priority      TaskPriority @default(MEDIUM)
  priorityRank  Int          @default(100) // числовой приоритет: чем меньше, тем важнее
  estimateHours Float        @default(0) // оценка трудоёмкости
  assigneeId    Int? // исполнитель
  dueDate       DateTime?
  createdAt     DateTime     @default(now())

  project     Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assignee    Employee?      @relation(fields: [assigneeId], references: [id], onDelete: SetNull)
  timeLogs    TimeLog[]
  assignments Assignment[]
  trackings   TimeTracking[]
}

enum TrackingState {
  RUNNING // время идёт
  PAUSED // на паузе
}

// Активный трекер времени по задаче: копит время кусочками (старт/пауза/продолжить).
// При остановке превращается в TimeLog. RUNNING-трекеры = «сейчас трекается время».
model TimeTracking {
  id             Int           @id @default(autoincrement())
  taskId         Int
  employeeId     Int
  state          TrackingState @default(RUNNING)
  startedAt      DateTime? // начало текущего идущего отрезка (null на паузе)
  accumulatedSec Int           @default(0) // накоплено секунд из прошлых отрезков
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  task     Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([taskId, employeeId])
}

// Фактически отработанное время по задаче
model TimeLog {
  id         Int      @id @default(autoincrement())
  taskId     Int
  employeeId Int
  date       DateTime @default(now()) // день работы
  hours      Float
  note       String?
  createdAt  DateTime @default(now())

  task     Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
}

// Плановый слот в календаре: сотрудник работает над задачей с startAt по endAt.
// Пересечение слотов одного сотрудника = конфликт (проверяется в сервисе).
model Assignment {
  id         Int      @id @default(autoincrement())
  employeeId Int
  taskId     Int
  startAt    DateTime
  endAt      DateTime
  note       String?
  createdAt  DateTime @default(now())

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  task     Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([employeeId, startAt])
}

// Отпуска/больничные/отгулы. Блокируют планирование на пересекающиеся дни.
model Absence {
  id         Int         @id @default(autoincrement())
  employeeId Int
  type       AbsenceType @default(VACATION)
  startDate  DateTime // включительно (день)
  endDate    DateTime // включительно (день)
  note       String?
  createdAt  DateTime    @default(now())

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId, startDate])
}
