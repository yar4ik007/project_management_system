# Домен: Caddy САМ выпускает сертификат Let's Encrypt и АВТОМАТИЧЕСКИ его продлевает
# (обновляет примерно за 30 дней до истечения). certbot/cron не нужны — всё встроено.
# Сертификаты хранятся в docker-томе caddy_data и переживают перезапуски.
# Пока eyeofboss.ru не делегирован в .ru (идёт идентификация) — выпуск будет
# повторяться в фоне и произойдёт сам, как только домен начнёт резолвиться на сервер.
eyeofboss.ru, www.eyeofboss.ru {
	encode gzip
	reverse_proxy frontend:80
}

# Запасной доступ по HTTP на IP (пока домен не поднялся и на всякий случай).
http://109.107.185.160 {
	encode gzip
	reverse_proxy frontend:80
}
